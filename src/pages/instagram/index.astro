---
import { readFile } from 'node:fs/promises';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { normalizeInstagramPost } from '../../lib/instagram-media.js';
const dataUrl = new URL('../../../public/instagram/posts.json', import.meta.url);
let feed = { username: 'xtvjdev', fetchedAt: null, posts: [] };
try { feed = JSON.parse((await readFile(dataUrl, 'utf8')).replace(/^\\uFEFF/, '')); } catch {}
const posts = (feed.posts || []).map(normalizeInstagramPost);
const apiUrl = import.meta.env.PUBLIC_INSTAGRAM_API_URL || '';
const base = import.meta.env.BASE_URL;
const dateFormat = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const numberFormat = new Intl.NumberFormat('zh-CN');
const mediaLabel = (type) => ({ IMAGE: '照片', VIDEO: '视频', REELS: 'Reel', CAROUSEL_ALBUM: '图集' }[type] || '媒体');
const mediaSrc = (url) => url ? (/^https?:\/\//.test(url) ? url : base + url.replace(/^\//, '')) : '';
const mediaAlt = (post, index) => post.caption ? post.caption.slice(0, 120) : `Instagram 帖子媒体 ${index + 1}`;
---
<SiteLayout title="Instagram" description="XTVJ 在 Instagram 上分享的照片、视频与日常记录。">
<section class="ig-page">
  <header class="ig-heading">
    <div class="ig-heading-copy">
      <p class="eyebrow"><span class="ig-glyph">◎</span> INSTAGRAM JOURNAL</p>
      <h1>镜头里的日常<span>，慢慢收藏。</span></h1>
      <p class="ig-lede">这里收录了我在 Instagram 分享的照片、片段和生活记录。</p>
    </div>
    <a class="ig-profile" href="https://www.instagram.com/xtvjdev/" target="_blank" rel="noopener noreferrer">
      <span class="profile-avatar">X</span><span class="profile-copy"><strong>@{feed.username || 'xtvjdev'}</strong><small>在 Instagram 查看个人主页 ↗</small></span>
    </a>
  </header>
  <div class="feed-bar"><span><i></i> 最新分享</span><span id="feed-status" role="status" aria-live="polite">{apiUrl ? '正在获取最新帖子…' : (posts.length ? '最近构建缓存' : '实时接口待配置')}</span></div>
  <div class="ig-feed" id="ig-feed" data-api-url={apiUrl} data-fallback-count={posts.length}>
    {posts.map((post, index) => <article class="ig-post">
      <div class="post-media">
        {post.media.map((item, mediaIndex) => <div class="media-slide" hidden={mediaIndex > 0}>
          {item.type === 'VIDEO' && item.url ? <video controls muted playsinline preload="none" poster={mediaSrc(item.thumbnailUrl)} data-permalink={post.permalink} aria-label={mediaAlt(post, mediaIndex)}><source src={mediaSrc(item.url)} /></video>
          : item.type === 'IMAGE' && item.url ? <button class="post-visual" type="button" aria-label="在当前页面放大查看图片" aria-haspopup="dialog" aria-controls="ig-lightbox"><img src={mediaSrc(item.url)} alt={mediaAlt(post, mediaIndex)} loading={index > 1 ? 'lazy' : 'eager'} /></button>
          : item.type === 'VIDEO' ? <div class="media-unavailable">{item.thumbnailUrl ? <img src={mediaSrc(item.thumbnailUrl)} alt={mediaAlt(post, mediaIndex)} loading="lazy" /> : <span class="visual-placeholder">◎</span>}<p role="status">暂未取得视频播放地址</p></div>
          : <a class="media-fallback" href={post.permalink} target="_blank" rel="noopener noreferrer">{item.thumbnailUrl || (item.type === 'IMAGE' && item.url) ? <img src={mediaSrc(item.thumbnailUrl || item.url)} alt={mediaAlt(post, mediaIndex)} loading="lazy" /> : <span class="visual-placeholder">◎</span>}<span>在 Instagram 查看此媒体 ↗</span></a>}
        </div>)}
        <span class="media-badge">{mediaLabel(post.mediaType)}</span>
        {post.media.length > 1 && <div class="media-pagination"><button type="button" class="media-prev" aria-label="上一项媒体" disabled>‹</button><span aria-live="polite">1 / {post.media.length}</span><button type="button" class="media-next" aria-label="下一项媒体">›</button></div>}
      </div>
      <div class="post-detail">
        <div class="post-meta"><time datetime={post.timestamp}>{dateFormat.format(new Date(post.timestamp))}</time><span class="post-dot">·</span><span>{mediaLabel(post.mediaType)}</span><a href={post.permalink} target="_blank" rel="noopener noreferrer">查看原帖 ↗</a></div>
        <p class="post-caption">{post.caption || '这篇分享没有添加文字。'}</p>
        <button class="caption-toggle" type="button" hidden aria-expanded="false">展开全文</button>
        <div class="post-stats">
          {post.likes !== null && post.likes !== undefined && <span><b>♡</b>{numberFormat.format(post.likes)} <small>赞</small></span>}
          {post.comments !== null && post.comments !== undefined && <span><b>◌</b>{numberFormat.format(post.comments)} <small>评论</small></span>}
          <span class="post-account">@{feed.username}</span>
        </div>
      </div>
    </article>)}
  </div>
  <dialog class="ig-lightbox" id="ig-lightbox" aria-label="图片预览">
    <div class="lightbox-shell">
      <div class="lightbox-toolbar"><span>图片预览</span><button class="lightbox-close" type="button" aria-label="关闭图片预览">×</button></div>
      <div class="lightbox-stage" id="lightbox-stage"><img id="lightbox-image" alt="" draggable="false" /></div>
      <div class="lightbox-controls" aria-label="图片缩放控制">
        <button type="button" data-zoom="out" aria-label="缩小图片">−</button>
        <span id="lightbox-zoom" aria-live="polite">100%</span>
        <button type="button" data-zoom="in" aria-label="放大图片">＋</button>
        <button type="button" data-zoom="reset">适应窗口</button>
      </div>
    </div>
  </dialog>
  <div class="feed-pagination" id="feed-pagination" hidden><button id="load-more" type="button">加载更多帖子 <span aria-hidden="true">↓</span></button><p id="page-status" role="status" aria-live="polite"></p></div>
  <section class="ig-empty" hidden={posts.length > 0}>
    <div class="empty-camera"><span></span></div><p class="empty-kicker">A LITTLE WINDOW TO MY WORLD</p>
    <h2>新记录正在路上</h2><p>配置 Instagram API 后，这里会自动整理最新的帖子。也可以先去 Instagram 看看我的分享。</p>
    <a href="https://www.instagram.com/xtvjdev/" target="_blank" rel="noopener noreferrer">前往 Instagram <span>↗</span></a>
  </section>
  {feed.fetchedAt && <p class="sync-note">最近同步于 {dateFormat.format(new Date(feed.fetchedAt))} · 内容来自 Instagram</p>}
</section>
</SiteLayout>
<script>
import { initInstagramPlayback } from '../../scripts/instagram-playback.js';
import { normalizeInstagramPost } from '../../lib/instagram-media.js';
const root = document.querySelector('#ig-feed');
const configuredApiUrl = root?.dataset.apiUrl?.trim();
const fallbackCount = Number(root?.dataset.fallbackCount || 0);
const prepareCaptions = (articles) => {
  for (const article of articles) {
    const caption = article.querySelector('.post-caption');
    const button = article.querySelector('.caption-toggle');
    if (!caption || !button || article.classList.contains('caption-expanded')) continue;
    button.hidden = true;
    article.classList.add('caption-collapsed');
    if (caption.scrollHeight > caption.clientHeight + 2) button.hidden = false;
    else article.classList.remove('caption-collapsed');
  }
};
root?.addEventListener('click', (event) => {
  const button = event.target.closest('.caption-toggle');
  if (!button) return;
  const article = button.closest('.ig-post');
  const expanded = article.classList.toggle('caption-expanded');
  button.setAttribute('aria-expanded', String(expanded));
  button.textContent = expanded ? '收起文案' : '展开全文';
});
if (root) requestAnimationFrame(() => prepareCaptions(root.querySelectorAll('.ig-post')));
window.addEventListener('resize', () => requestAnimationFrame(() => prepareCaptions(root?.querySelectorAll('.ig-post') || [])));
const lightbox = document.querySelector('#ig-lightbox');
const playback = initInstagramPlayback(root, { isBlocked: () => Boolean(lightbox?.open) });
const lightboxStage = document.querySelector('#lightbox-stage');
const lightboxImage = document.querySelector('#lightbox-image');
const zoomLabel = document.querySelector('#lightbox-zoom');
const pointers = new Map();
let zoom = 1;
let panX = 0;
let panY = 0;
let fitWidth = 0;
let fitHeight = 0;
const clampPan = () => {
  const maxX = Math.max(0, (fitWidth * zoom - lightboxStage.clientWidth) / 2);
  const maxY = Math.max(0, (fitHeight * zoom - lightboxStage.clientHeight) / 2);
  panX = Math.max(-maxX, Math.min(maxX, panX));
  panY = Math.max(-maxY, Math.min(maxY, panY));
};
const renderZoom = () => {
  clampPan();
  lightboxImage.style.left = (lightboxStage.clientWidth - fitWidth) / 2 + panX + 'px';
  lightboxImage.style.top = (lightboxStage.clientHeight - fitHeight) / 2 + panY + 'px';
  lightboxImage.style.transform = `scale(${zoom})`;
  zoomLabel.textContent = Math.round(zoom * 100) + '%';
  lightboxStage.classList.toggle('is-zoomed', zoom > 1);
};
const fitImage = () => {
  if (!lightboxImage.naturalWidth || !lightboxImage.naturalHeight || !lightboxStage.clientWidth || !lightboxStage.clientHeight) return;
  const fit = Math.min(lightboxStage.clientWidth / lightboxImage.naturalWidth, lightboxStage.clientHeight / lightboxImage.naturalHeight);
  fitWidth = lightboxImage.naturalWidth * fit;
  fitHeight = lightboxImage.naturalHeight * fit;
  lightboxImage.style.width = fitWidth + 'px';
  lightboxImage.style.height = fitHeight + 'px';
  lightboxImage.style.visibility = 'visible';
  renderZoom();
};
const setZoom = (value, clientX, clientY) => {
  const next = Math.max(0.25, Math.min(8, value));
  const rect = lightboxStage.getBoundingClientRect();
  const focalX = (clientX ?? rect.left + rect.width / 2) - rect.left - rect.width / 2;
  const focalY = (clientY ?? rect.top + rect.height / 2) - rect.top - rect.height / 2;
  const ratio = next / zoom;
  panX = focalX - (focalX - panX) * ratio;
  panY = focalY - (focalY - panY) * ratio;
  zoom = next;
  if (zoom <= 1) { panX = 0; panY = 0; }
  renderZoom();
};
root?.addEventListener('error', (event) => {
  const video = event.target.closest?.('video');
  if (!video || video.dataset.failed || video.error?.code === 1) return;
  video.dataset.failed = 'true';
  video.pause();
  const message = document.createElement('div');
  message.className = 'video-message';
  message.setAttribute('role', 'status');
  const label = document.createElement('span');
  label.textContent = '视频加载失败';
  const retry = document.createElement('button');
  retry.type = 'button';
  retry.className = 'video-retry';
  retry.textContent = '重新加载';
  message.append(label, retry);
  video.closest('.media-slide').append(message);
  playback.refresh();
}, true);
root?.addEventListener('click', (event) => {
  const retry = event.target.closest('.video-retry');
  if (!retry) return;
  const video = retry.closest('.media-slide').querySelector('video');
  delete video.dataset.failed;
  retry.closest('.video-message').remove();
  video.load();
  playback.refresh();
});
root?.addEventListener('click', (event) => {
  const nav = event.target.closest('.media-prev, .media-next');
  if (!nav) return;
  const media = nav.closest('.post-media');
  const slides = [...media.querySelectorAll('.media-slide')];
  const current = slides.findIndex((slide) => !slide.hidden);
  const next = Math.max(0, Math.min(slides.length - 1, current + (nav.classList.contains('media-next') ? 1 : -1)));
  if (next === current) return;
  slides[current].querySelector('video')?.pause();
  slides[current].hidden = true;
  slides[next].hidden = false;
  media.querySelector('.media-prev').disabled = next === 0;
  media.querySelector('.media-next').disabled = next === slides.length - 1;
  media.querySelector('.media-pagination span').textContent = (next + 1) + ' / ' + slides.length;
  playback.refresh();
});
root?.addEventListener('click', (event) => {
  const button = event.target.closest('.post-visual');
  const source = button?.querySelector('img');
  if (!source || !lightbox) return;
  lightboxImage.style.visibility = 'hidden';
  lightboxImage.src = source.currentSrc || source.src;
  lightboxImage.alt = source.alt;
  zoom = 1;
  panX = 0;
  panY = 0;
  fitWidth = 0;
  fitHeight = 0;
  lightbox.showModal();
  playback.refresh();
  if (lightboxImage.complete) fitImage();
  renderZoom();
});
lightboxImage?.addEventListener('load', fitImage);
lightbox?.querySelector('.lightbox-close')?.addEventListener('click', () => lightbox.close());
lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
lightbox?.addEventListener('close', () => { pointers.clear(); lightboxImage.removeAttribute('src'); playback.refresh(); });
lightbox?.querySelectorAll('[data-zoom]')?.forEach((button) => button.addEventListener('click', () => {
  if (button.dataset.zoom === 'reset') setZoom(1);
  else setZoom(zoom * (button.dataset.zoom === 'in' ? 1.25 : 0.8));
}));
lightboxStage?.addEventListener('wheel', (event) => {
  event.preventDefault();
  setZoom(zoom * (event.deltaY < 0 ? 1.2 : 1 / 1.2), event.clientX, event.clientY);
}, { passive: false });
lightboxStage?.addEventListener('dblclick', (event) => setZoom(zoom > 1 ? 1 : 2, event.clientX, event.clientY));
lightboxStage?.addEventListener('pointerdown', (event) => {
  if (event.pointerType === 'mouse' && event.button !== 0) return;
  lightboxStage.setPointerCapture(event.pointerId);
  pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
});
lightboxStage?.addEventListener('pointermove', (event) => {
  const previous = pointers.get(event.pointerId);
  if (!previous) return;
  if (pointers.size === 1) {
    if (zoom > 1) { panX += event.clientX - previous.x; panY += event.clientY - previous.y; renderZoom(); }
  } else if (pointers.size === 2) {
    const before = [...pointers.values()];
    pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
    const after = [...pointers.values()];
    const distance = (points) => Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y);
    const midpoint = (points) => ({ x: (points[0].x + points[1].x) / 2, y: (points[0].y + points[1].y) / 2 });
    const oldMid = midpoint(before);
    const newMid = midpoint(after);
    const oldDistance = distance(before);
    if (oldDistance > 0) setZoom(zoom * distance(after) / oldDistance, newMid.x, newMid.y);
    panX += newMid.x - oldMid.x;
    panY += newMid.y - oldMid.y;
    renderZoom();
    return;
  }
  pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
});
const releasePointer = (event) => pointers.delete(event.pointerId);
lightboxStage?.addEventListener('pointerup', releasePointer);
lightboxStage?.addEventListener('pointercancel', releasePointer);
lightbox?.addEventListener('keydown', (event) => {
  if (event.key === '+' || event.key === '=') { event.preventDefault(); setZoom(zoom * 1.25); }
  if (event.key === '-') { event.preventDefault(); setZoom(zoom * 0.8); }
  if (event.key === '0') { event.preventDefault(); setZoom(1); }
});
window.addEventListener('resize', () => { if (lightbox?.open) fitImage(); });
const apiUrl = (() => {
  if (!configuredApiUrl) return '';
  try {
    const endpoint = new URL(configuredApiUrl);
    endpoint.pathname = endpoint.pathname.replace(/\/+$/, '');
    if (!endpoint.pathname || endpoint.pathname === '/') endpoint.pathname = '/api/instagram';
    return endpoint.toString();
  } catch {
    return '';
  }
})();
if (root && apiUrl) {
  const status = document.querySelector('#feed-status');
  const empty = document.querySelector('.ig-empty');
  const mediaName = (type) => ({ IMAGE: '照片', VIDEO: '视频', REELS: 'Reel', CAROUSEL_ALBUM: '图集' }[type] || '媒体');
  const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
  const count = new Intl.NumberFormat('zh-CN');
  const el = (tag, className, text) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };
  const postNode = (post, username, index) => {
    const article = el('article', 'ig-post');
    const media = el('div', 'post-media');
    const resolveSrc = (url) => url && /^https?:\/\//.test(url) ? url : url ? import.meta.env.BASE_URL + url.replace(/^\//, '') : '';
    post.media.forEach((item, mediaIndex) => {
      const slide = el('div', 'media-slide');
      slide.hidden = mediaIndex > 0;
      const alt = post.caption ? post.caption.slice(0, 120) : 'Instagram 帖子媒体 ' + (mediaIndex + 1);
      if (item.type === 'VIDEO' && item.url) {
        const video = el('video');
        video.controls = true;
        video.defaultMuted = true;
        video.muted = true;
        video.playsInline = true;
        video.preload = 'none';
        video.setAttribute('aria-label', alt);
        video.dataset.permalink = post.permalink || '';
        if (item.thumbnailUrl) video.poster = resolveSrc(item.thumbnailUrl);
        const source = el('source');
        source.src = resolveSrc(item.url);
        video.append(source);
        slide.append(video);
      } else if (item.type === 'IMAGE' && item.url) {
        const button = el('button', 'post-visual');
        button.type = 'button';
        button.setAttribute('aria-label', '在当前页面放大查看图片');
        button.setAttribute('aria-haspopup', 'dialog');
        button.setAttribute('aria-controls', 'ig-lightbox');
        const image = el('img');
        image.src = resolveSrc(item.url);
        image.alt = alt;
        image.loading = index > 1 ? 'lazy' : 'eager';
        button.append(image);
        slide.append(button);
      } else if (item.type === 'VIDEO') {
        const unavailable = el('div', 'media-unavailable');
        if (item.thumbnailUrl) {
          const image = el('img');
          image.src = resolveSrc(item.thumbnailUrl);
          image.alt = alt;
          image.loading = 'lazy';
          unavailable.append(image);
        } else unavailable.append(el('span', 'visual-placeholder', '◎'));
        const message = el('p', '', '暂未取得视频播放地址');
        message.setAttribute('role', 'status');
        unavailable.append(message);
        slide.append(unavailable);
      } else {
        const fallback = el('a', 'media-fallback');
        fallback.href = post.permalink || '#';
        fallback.target = '_blank';
        fallback.rel = 'noopener noreferrer';
        if (item.thumbnailUrl || (item.type === 'IMAGE' && item.url)) {
          const image = el('img');
          image.src = resolveSrc(item.thumbnailUrl || item.url);
          image.alt = alt;
          image.loading = 'lazy';
          fallback.append(image);
        } else fallback.append(el('span', 'visual-placeholder', '◎'));
        fallback.append(el('span', '', '在 Instagram 查看此媒体 ↗'));
        slide.append(fallback);
      }
      media.append(slide);
    });
    media.append(el('span', 'media-badge', mediaName(post.mediaType)));
    if (post.media.length > 1) {
      const pagination = el('div', 'media-pagination');
      const prev = el('button', 'media-prev', '‹');
      prev.type = 'button';
      prev.disabled = true;
      prev.setAttribute('aria-label', '上一项媒体');
      const next = el('button', 'media-next', '›');
      next.type = 'button';
      next.setAttribute('aria-label', '下一项媒体');
      pagination.append(prev, el('span', '', '1 / ' + post.media.length), next);
      media.append(pagination);
    }
    const detail = el('div', 'post-detail');
    const meta = el('div', 'post-meta');
    const time = el('time', '', date.format(new Date(post.timestamp)));
    time.dateTime = post.timestamp;
    meta.append(time, el('span', 'post-dot', '·'), el('span', '', mediaName(post.mediaType)));
    const original = el('a', '', '查看原帖 ↗');
    original.href = post.permalink;
    original.target = '_blank';
    original.rel = 'noopener noreferrer';
    meta.append(original);
    const caption = el('p', 'post-caption', post.caption || '这篇分享没有添加文字。');
    const stats = el('div', 'post-stats');
    if (post.likes !== null && post.likes !== undefined) {
      const likes = el('span');
      likes.append(el('b', '', '♡'), document.createTextNode(count.format(post.likes) + ' '), el('small', '', '赞'));
      stats.append(likes);
    }
    if (post.comments !== null && post.comments !== undefined) {
      const comments = el('span');
      comments.append(el('b', '', '◌'), document.createTextNode(count.format(post.comments) + ' '), el('small', '', '评论'));
      stats.append(comments);
    }
    stats.append(el('span', 'post-account', '@' + username));
    const captionToggle = el('button', 'caption-toggle', '展开全文');
    captionToggle.type = 'button';
    captionToggle.hidden = true;
    captionToggle.setAttribute('aria-expanded', 'false');
    detail.append(meta, caption, captionToggle, stats);
    article.append(media, detail);
    return article;
  };
  const pagination = document.querySelector('#feed-pagination');
  const loadMore = document.querySelector('#load-more');
  const pageStatus = document.querySelector('#page-status');
  let nextCursor = null;
  let loaded = 0;
  let loading = false;
  const fetchPage = async (first = false) => {
    if (loading || (!first && !nextCursor)) return;
    loading = true;
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 15000);
    if (loadMore) { loadMore.disabled = true; loadMore.textContent = '正在加载…'; }
    if (pageStatus) pageStatus.textContent = '';
    try {
      const endpoint = new URL(apiUrl);
      if (!first) endpoint.searchParams.set('after', nextCursor);
      const response = await fetch(endpoint, { headers: { Accept: 'application/json' }, cache: 'no-store', signal: controller.signal });
      const feed = await response.json();
      if (!response.ok || feed.error) throw new Error(feed.error || 'Instagram API HTTP ' + response.status);
      if (!Array.isArray(feed.posts)) throw new Error('Invalid Instagram feed');
      const nodes = feed.posts.map((post, index) => postNode(normalizeInstagramPost(post), feed.username || 'xtvjdev', loaded + index));
      if (first) root.replaceChildren(...nodes);
      else root.append(...nodes);
      playback.refresh();
      requestAnimationFrame(() => prepareCaptions(nodes));
      loaded += feed.posts.length;
      nextCursor = feed.nextCursor || null;
      if (empty) empty.hidden = loaded > 0;
      status.textContent = loaded ? '已加载 ' + loaded + ' 篇记录 · 实时' : '接口已连接，返回 0 条帖子';
      if (!loaded && empty) {
        empty.querySelector('h2').textContent = 'Instagram 接口已连接，但没有返回帖子';
        empty.querySelector('p:not(.empty-kicker)').textContent = '请确认 Cloudflare Worker 使用的 token 对应 @xtvjdev，并具有读取媒体内容的权限。';
      }
      if (pagination) pagination.hidden = !nextCursor;
      if (pageStatus && !first) pageStatus.textContent = '已加载 ' + loaded + ' 篇帖子';
      const note = document.querySelector('.sync-note');
      if (note) note.textContent = '刚刚从 Instagram 获取 · 内容来自 Instagram';
    } catch (error) {
      console.error('Instagram feed request failed:', error);
      const message = error.name === 'AbortError' ? '请求超时，请稍后重试' : (error.message || '请检查 Worker 配置');
      if (first) {
        status.textContent = fallbackCount ? '实时读取失败，显示最近缓存' : '读取失败：' + message;
        if (empty && !fallbackCount) {
          empty.querySelector('h2').textContent = '无法读取 Instagram 帖子';
          empty.querySelector('p:not(.empty-kicker)').textContent = message;
        }
      } else if (pageStatus) pageStatus.textContent = '加载失败：' + message + '，请重试。';
    } finally {
      loading = false;
      window.clearTimeout(timeout);
      if (loadMore) { loadMore.disabled = false; loadMore.innerHTML = '加载更多帖子 <span aria-hidden="true">↓</span>'; }
    }
  };
  loadMore?.addEventListener('click', () => fetchPage());
  fetchPage(true);
} else if (root) {
  const status = document.querySelector('#feed-status');
  const message = configuredApiUrl ? '\u63a5\u53e3\u5730\u5740\u65e0\u6548\uff0c\u8bf7\u68c0\u67e5 GitHub variable' : '\u672a\u914d\u7f6e\u5b9e\u65f6\u63a5\u53e3\u5730\u5740';
  if (status) status.textContent = message;
  if (root && !configuredApiUrl) {
    const empty = document.querySelector('.ig-empty');
    if (empty) {
      empty.querySelector('h2').textContent = message;
      empty.querySelector('p:not(.empty-kicker)').textContent = '请在 GitHub 仓库 Actions variables 中设置 PUBLIC_INSTAGRAM_API_URL，然后重新部署。';
    }
  }
}
</script>
