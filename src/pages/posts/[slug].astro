---
import { render } from 'astro:content';
import { getPosts } from '../../lib/posts';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatDate, postHref, sortPosts, tagHref } from '../../lib/site';

export async function getStaticPaths() {
  const posts = sortPosts(await getPosts());
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const posts = sortPosts(await getPosts());
const { post } = Astro.props;
const { Content } = await render(post);
const index = posts.findIndex((item) => item.id === post.id);
const newer = posts[index - 1];
const older = posts[index + 1];
---

<SiteLayout title={post.data.title}>
  <nav class="article-side-pagination" aria-label="快速切换文章">
    {newer && <a class="article-side-link article-side-newer" href={postHref(newer.data.slug)} aria-label={`上一篇：${newer.data.title}`} title={`上一篇：${newer.data.title}`}><span aria-hidden="true">←</span><span class="sr-only">上一篇：{newer.data.title}</span></a>}
    {older && <a class="article-side-link article-side-older" href={postHref(older.data.slug)} aria-label={`下一篇：${older.data.title}`} title={`下一篇：${older.data.title}`}><span aria-hidden="true">→</span><span class="sr-only">下一篇：{older.data.title}</span></a>}
  </nav>
  <article class="article-page">
    <a class="back-link" href={import.meta.env.BASE_URL}>← 返回文章列表</a>
    <header class="article-header">
      <p class="eyebrow">{post.data.tags[0] ?? 'NOTE'}</p>
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <span>发布于 {formatDate(post.data.date)}</span>
        {post.data.updated && <span>更新于 {formatDate(post.data.updated)}</span>}
        {typeof post.data.readMinutes === 'number' && <span>{post.data.readMinutes} 分钟阅读</span>}
      </div>
    </header>
    <div class="article-body"><Content /></div>
    <div class="article-tags">
      {post.data.tags.map((tag) => <a class="tag" href={tagHref(tag)}>{tag}</a>)}
    </div>
    <nav class="article-pagination" aria-label="前后文章">
      {newer ? <a href={postHref(newer.data.slug)}><small>上一篇</small><span>{newer.data.title}</span></a> : <span></span>}
      {older ? <a class="older" href={postHref(older.data.slug)}><small>下一篇</small><span>{older.data.title}</span></a> : <span></span>}
    </nav>
  </article>
</SiteLayout>
