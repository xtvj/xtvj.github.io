---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="搜索文章">
  <section class="archive-heading search-heading">
    <p class="eyebrow">SEARCH</p>
    <h1>搜索文章</h1>
    <label class="sr-only" for="search-input">搜索标题和标签</label>
    <input id="search-input" class="search-input" type="search" placeholder="输入关键词…" autocomplete="off" />
    <p id="search-status" aria-live="polite">输入关键词，搜索标题和标签。</p>
  </section>
  <section id="search-results" class="post-list" aria-live="polite"></section>
</SiteLayout>

<script>
  import '../scripts/search.ts';
</script>
