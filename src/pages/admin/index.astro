---
import SiteLayout from '../../layouts/SiteLayout.astro';
import RecentComments from '../../components/RecentComments.astro';
import { getPosts } from '../../lib/posts';
import { formatDate, sortPosts } from '../../lib/site';

const viewsApiUrl = import.meta.env.PUBLIC_POST_VIEWS_API_URL || '';
const adminApiUrl = viewsApiUrl ? new URL('./admin/comments', viewsApiUrl).toString() : '';
const posts = sortPosts(await getPosts());
---

<SiteLayout title="评论管理" description="博客评论管理" noindex>
  <section class="admin-page" data-admin-api={adminApiUrl}>
    <div class="admin-page-heading">
      <div><p class="eyebrow">MODERATION</p><h1>评论管理</h1><p class="admin-intro">按文章查看评论，及时清理不合适的内容。</p></div>
      <a class="admin-settings-link" href={`${import.meta.env.BASE_URL}admin/settings/`} id="admin-settings-link" hidden>账号设置 <span aria-hidden="true">↗</span></a>
    </div>

    <RecentComments />

    <form class="admin-login" id="admin-login">
      <label for="admin-password">管理密码</label>
      <div class="admin-login-row">
        <input id="admin-password" type="password" required autocomplete="current-password" placeholder="输入管理密码" />
        <button type="submit">进入管理</button>
      </div>
    </form>

    <div class="admin-dashboard" id="admin-dashboard" hidden>
      <div class="admin-toolbar">
        <span>已公开的评论</span>
        <button class="admin-logout" id="admin-logout" type="button">退出登录</button>
      </div>
      <div class="admin-workspace">
        <aside class="admin-article-panel">
          <p class="admin-panel-kicker">文章筛选</p>
          <label class="admin-post-label" for="admin-post-select">选择文章</label>
          <select id="admin-post-select" class="admin-post-select" disabled={posts.length === 0}>
            {posts.length === 0 && <option value="">暂无文章</option>}
            {posts.map((post, index) => <option value={post.data.slug} selected={index === 0}>{formatDate(post.data.date)} · {post.data.title}</option>)}
          </select>
          <div class="admin-post-list" role="group" aria-label="选择文章">
            {posts.map((post, index) => <button type="button" class="admin-post-item" data-post-slug={post.data.slug} aria-pressed={index === 0 ? 'true' : 'false'}><span class="admin-post-item-date">{formatDate(post.data.date)}</span><span class="admin-post-item-title">{post.data.title}</span></button>)}
            {posts.length === 0 && <p class="admin-panel-hint">暂无文章。</p>}
          </div>
          <p class="admin-panel-hint">按发布时间排列，最新文章在最上方。</p>
        </aside>
        <div class="admin-comment-panel">
          <div class="admin-comments-heading"><h2>评论列表</h2><span id="admin-comment-count" aria-live="polite"></span></div>
          <div class="admin-comments" id="admin-comments"></div>
          <div class="admin-empty-state" id="admin-empty-state" hidden>
            <svg viewBox="0 0 160 120" fill="none" aria-hidden="true"><path d="M30 27h77a15 15 0 0 1 15 15v38a15 15 0 0 1-15 15H68l-20 14V95H30a15 15 0 0 1-15-15V42a15 15 0 0 1 15-15Z" stroke="currentColor" stroke-width="3"/><path d="M48 52h42M48 67h29" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M115 12h12a16 16 0 0 1 16 16v32" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
            <h3>这篇文章还没有评论</h3>
            <p>有新留言时，会显示在这里。</p>
          </div>
          <button class="admin-more" id="admin-more" type="button" hidden>加载更多评论</button>
        </div>
      </div>
    </div>
    <p class="admin-message" id="admin-message" role="status">
      {adminApiUrl ? '密码由 Worker 验证；管理会话仅保存在当前浏览器标签页。' : '请先配置 PUBLIC_POST_VIEWS_API_URL。'}
    </p>
  </section>
</SiteLayout>

<script>
  import '../../scripts/admin-comments.ts';
</script>
