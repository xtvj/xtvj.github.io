---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Icon } from 'astro-icon/components';

const socialLinks = [
  {
    name: 'GitHub',
    icon: 'simple-icons:github',
    href: 'https://github.com/xtvj',
  },
  {
    name: 'X',
    icon: 'simple-icons:x',
    href: 'https://x.com/zhangxuVlog',
  },
  {
    name: 'Instagram',
    icon: 'simple-icons:instagram',
    href: 'https://www.instagram.com/xtvjdev/',
  },
  {
    name: 'YouTube',
    icon: 'simple-icons:youtube',
    href: 'https://www.youtube.com/@xtvjus',
  },
  {
    name: 'Facebook',
    icon: 'simple-icons:facebook',
    href: 'https://www.facebook.com/zhangxu0922',
  },
];
---

<SiteLayout title="关于">
  <article class="about-page">
    <p class="eyebrow">ABOUT THIS BLOG</p>
    <h1>关于</h1>
    <p>这里是 XTVJ 的个人博客。</p>

    <nav class="social-links" aria-label="社交媒体">
      {socialLinks.map((item) => (
        <a
          class="social-link"
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`在${item.name}上关注我`}
          title={item.name}
        >
          <Icon name={item.icon} size="22" />
          <span>{item.name}</span>
        </a>
      ))}
    </nav>
  </article>
</SiteLayout>

<style>
  .about-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }

  .eyebrow {
    color: #777;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border: 1px solid #ddd;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .social-link:hover {
    border-color: currentColor;
    background-color: #f5f5f5;
  }

  .social-link :global(svg) {
    flex: none;
  }
</style>