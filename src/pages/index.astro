---
import { getPosts } from '../lib/posts';
import PostList from '../components/PostList.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import RecentComments from '../components/RecentComments.astro';
import { sortPosts } from '../lib/site';

const posts = sortPosts(await getPosts());
const pageSize = 10;
---

<SiteLayout description="XTVJ 的个人博客，记录电影、软件、电脑与日常使用技巧。">
  <section class="intro intro-compact" aria-label="博客概况">
    <div class="intro-meta"><span>{posts.length} 篇文章</span></div>
  </section>

  <RecentComments />

  <PostList posts={posts} pageSize={pageSize} />
</SiteLayout>
