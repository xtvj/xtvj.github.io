---
import { pageHref } from '../lib/site';

interface Props {
  current: number;
  total: number;
}

const { current, total } = Astro.props;
---

{total > 1 && (
  <nav class="pagination" aria-label="文章分页">
    {current > 1 && <a href={pageHref(current - 1)}>← 上一页</a>}
    <span>第 {current} / {total} 页</span>
    {current < total && <a href={pageHref(current + 1)}>下一页 →</a>}
  </nav>
)}
