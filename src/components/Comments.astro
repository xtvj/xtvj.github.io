---
import { COMMENT_AVATARS, avatarPath } from '../lib/comment-avatars.js';
interface Props { slug: string }
const { slug } = Astro.props;
const viewsApiUrl = import.meta.env.PUBLIC_POST_VIEWS_API_URL || '';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const commentsApiUrl = viewsApiUrl ? new URL('./comments', viewsApiUrl).toString() : '';
---

<section class="comments" id="comments" aria-labelledby="comments-title" data-post-slug={slug} data-comments-api={commentsApiUrl}>
  <div class="comments-heading">
    <p class="eyebrow">DISCUSSION</p>
    <h2 id="comments-title">评论</h2>
    <p>欢迎分享想法。发表评论后会立即显示。</p>
  </div>
  <div class="comments-list" id="comments-list" aria-live="polite"></div>
  <button class="comments-more" id="comments-more" type="button" hidden>加载更多评论</button>
  <p class="comments-list-status" id="comments-list-status" role="status">正在加载评论…</p>

  <form class="comment-form" id="comment-form">
    <h3>发表评论</h3>
    <div class="comment-admin-identity" id="comment-admin-identity" hidden><img id="comment-admin-avatar" width="42" height="42" alt="" /><span><strong id="comment-admin-name"></strong><small>管理员身份</small></span></div>
    <p class="comment-reply-label" id="comment-reply-label" hidden></p>
    <button class="comment-cancel-reply" id="comment-cancel-reply" type="button" hidden>取消回复</button>
    <div class="comment-guest-fields" id="comment-guest-fields">
      <button class="comment-avatar-trigger" id="comment-avatar-trigger" type="button" aria-label="选择评论头像" title="选择评论头像"><img id="comment-guest-avatar" src={avatarPath('moses', import.meta.env.BASE_URL)} width="54" height="54" alt="" /><span>更换头像</span></button>
      <div class="comment-nickname-field"><label for="comment-nickname">昵称</label><input id="comment-nickname" name="nickname" type="text" maxlength="30" required autocomplete="nickname" placeholder="怎么称呼你？" /></div>
    </div>
    <label for="comment-body">评论内容</label>
    <textarea id="comment-body" name="body" maxlength="2000" rows="5" required placeholder="写下你的想法…"></textarea>
    {siteKey && <div id="comment-turnstile"><div class="cf-turnstile" data-sitekey={siteKey} data-action="comment" data-theme="auto"></div></div>}
    <button class="comment-submit" type="submit" disabled={!siteKey || !commentsApiUrl}>提交评论</button>
    <p class="comment-form-status" id="comment-form-status" role="status">
      {!commentsApiUrl ? '评论接口尚未配置。' : !siteKey ? '评论验证尚未配置。' : '通过安全验证后，评论会立即公开。'}
    </p>
  </form>
  <dialog class="comment-avatar-dialog" id="comment-avatar-dialog" aria-labelledby="comment-avatar-title">
    <div class="comment-avatar-dialog-heading"><h3 id="comment-avatar-title">选择头像</h3><button type="button" id="comment-avatar-close" aria-label="关闭头像选择">×</button></div>
    <p>头像会保存在当前浏览器中，用于之后发表的评论。</p>
    <div class="comment-avatar-options">
      {COMMENT_AVATARS.map((avatar) => <button type="button" data-avatar-id={avatar.id} aria-pressed="false"><img src={avatarPath(avatar.id, import.meta.env.BASE_URL)} width="88" height="88" alt="" /><span>{avatar.name}</span></button>)}
    </div>
  </dialog>
</section>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  import '../scripts/comments.ts';
</script>
