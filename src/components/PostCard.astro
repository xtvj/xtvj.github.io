---
import type { Post } from '../lib/site';
import { postExcerpt } from '../lib/posts';
import { formatDate, postHref, tagHref } from '../lib/site';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const excerpt = postExcerpt(post.body);
---

<article class="post-card">
  <time class="post-card-date" datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time>
  <div class="post-card-content">
    <h2><a class="post-card-link" href={postHref(data.slug)}>{data.title}</a></h2>
    {excerpt && <p class="post-card-excerpt">{excerpt}</p>}
    <div class="post-card-footer">
      <div class="post-tags">
        {data.tags.slice(0, 3).map((tag) => <a class="tag" href={tagHref(tag)}>{tag}</a>)}
      </div>
      <div class="post-stats">
        {data.updated && <span>更新于 {formatDate(data.updated)}</span>}
        {typeof data.readMinutes === 'number' && <span>{data.readMinutes} 分钟</span>}
        <span>阅读 <span data-post-views={data.slug}>{(data.views ?? 0).toLocaleString('zh-CN')}</span> 次</span>
      </div>
    </div>
  </div>
</article>
